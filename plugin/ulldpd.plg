<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "ulldpd">
<!ENTITY author    "davidcoulson">
<!ENTITY version   "2026.10.19">
<!ENTITY launch    "Settings/ULLDPDsettings">
<!ENTITY gitURL    "https://raw.githubusercontent.com/davidcoulson/LLDP-unRAID/main">
<!ENTITY pluginURL "&gitURL;/plugin/&name;.plg">
<!ENTITY pkgURL    "&gitURL;/packages">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY plgNAME   "ulldpd-2026.10.19-x86_64-1">
<!ENTITY plgMD5    "052d653b0e31ed53a08e5abd37786b91">
<!ENTITY plgSHA256 "1f51712d5976727c510de6b89da70bbaee4f8b35f69b2d185bddb228dea7a313">
<!ENTITY lldpdNAME "lldpd-1.0.22-x86_64-1">
<!ENTITY lldpdMD5  "09d7c96070494afdeb31e5d0629200c4">
<!ENTITY lldpdSHA256 "d31e863c54b527f09ca10595b1edb24d4af907ce29a7eb1b03c490a2fc01896c">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="https://github.com/davidcoulson/LLDP-unRAID/issues" min="6.12.0">

<CHANGES>
## LLDP for UNRAID
###2026.10.19
- change: removed the introductory LLDP description text from the settings page

###2026.10.18
#### Settings page and dashboard rework
- new: neighbors are shown as tables (interface, protocol, system name, chassis ID, port ID, port description, VLANs, management IPs, age) directly on the settings page and refresh automatically; the "Show Neighbors" popup is gone
- new: local chassis information shown as a compact table
- new: status line with running/stopped, pid, neighbor count and lldpd version
- new: dashboard tile with the neighbor summary (local interface to switch/port) linking to the settings page
- new: settings for interface pattern, management address pattern, chassis ID interface, system name and description overrides, transmit interval and hold, receive-only mode and interface description (ifAlias) updates
- new: advanced custom lldpd configuration (/boot/config/plugins/ulldpd/custom.conf), edited on the settings page and copied to /etc/lldpd.d/ at start
- change: help texts explain that Apply restarts the running service and what CDP/FDP/SONMP/EDP do
- security: all new settings are whitelisted and validated in both rc.lldpd and PHP (invalid values are ignored); the new endpoints are CSRF-protected, size-limited and escape all output
###2026.10.17
#### Fork release (davidcoulson/LLDP-unRAID), continuing the unmaintained project by desertwitch
- security: updated from lldpd-1.0.20 to lldpd-1.0.22 (fixes CVE-2026-46433, out-of-bounds read in VLAN handling)
- security: lldpd now runs with privilege separation (user/group _lldpd, chroot /run/lldpd)
- security: configuration is parsed as data (whitelisted keys/values) and no longer executed as shell code
- security: all lldpcli output on the settings page and neighbor view is HTML-escaped
- fix: lldpd is built without libxml2/readline and with its own libevent, so no libraries missing on Unraid 7.x are needed (minimum Unraid is now 6.12.0)
- fix: packages are downloaded and verified (MD5 and SHA256) before the running service is stopped; old package files are pruned
- fix: start/stop/restart report real failures, check readiness, and log with tag ulldpd; new status action
- fix: protocol settings are no longer dropped when applying with the service running
- change: update and download URLs now point to the davidcoulson fork
###2026.10.16
#### (upstream) Plugin Advisory: End of Support on 30.11.2026
The original author announced the end of support for the original repository; forks were explicitly welcome. This is such a fork.
###2026.10.06
- announce maintenance mode (no functional changes)
###2026.02.11
- new: updated from lldpd-1.0.19 to lldpd-1.0.20
###2025.08.21
- fix: make pages and dashboards compliant with new responsive UI
###2025.02.26
- fix: future-proofing changes to base plugin structure
###2025.01.24
- new: updated from lldpd-1.0.18 to lldpd-1.0.19
###2024.09.16
- fix: reworked bash scripts to better standards with more safety for strange configurational states
###2024.09.13
- important fix: address possible flock condition causing installation script to stall (thanks AgentXXL)
###2024.09.12
- fix: made optical changes regarding wording, positioning and helptexts on the LLDP Settings page
- fix: improved script security by handling of leading and trailing whitespaces in configurational values
- new: use of plugin usage metric functions to aid development of new features and planning for plugin updates (toggleable)
###2024.08.07
- new: switched from legacy to more recent update checking mechanism
###2024.04.15
- fix: only propagate LLDP information on physical network interfaces (eth*) instead of all network interfaces
###2024.03.11
- fix: moved around some statements in the installation and removal processes (no changes to packages)
###2024.02.26
- release note: welcome to the first version of the LLDP package.
- release note: please report any problems in the respective support topic.
</CHANGES>

<!--
download and verify all packages FIRST (nothing is stopped or changed if this fails)
-->
<FILE Name="&plgPATH;/&lldpdNAME;.txz" Min="6.12">
<URL>&pkgURL;/&lldpdNAME;.txz</URL>
<MD5>&lldpdMD5;</MD5>
<SHA256>&lldpdSHA256;</SHA256>
</FILE>

<FILE Name="&plgPATH;/&plgNAME;.txz" Min="6.12">
<URL>&gitURL;/archive/&plgNAME;.txz</URL>
<MD5>&plgMD5;</MD5>
<SHA256>&plgSHA256;</SHA256>
</FILE>

<!--
stop the service, install or upgrade the packages, prune old ones, start the service
-->
<FILE Run="/bin/bash">
<INLINE>
PLG=&plgPATH;

for f in "$PLG/&lldpdNAME;.txz" "$PLG/&plgNAME;.txz"; do
    if [ ! -s "$f" ]; then
        echo "ERROR: $f is missing; aborting before changing anything."
        exit 1
    fi
done

echo "Stopping existing LLDP service (before install/upgrade)..."
if [ -x /etc/rc.d/rc.lldpd ]; then
    /etc/rc.d/rc.lldpd stop
fi
killall lldpd >/dev/null 2>&amp;1

echo "Installing packages..."
if ! upgradepkg --install-new "$PLG/&lldpdNAME;.txz"; then
    echo "ERROR: installation of &lldpdNAME; failed."
    /etc/rc.d/rc.lldpd autostart
    exit 1
fi
if ! upgradepkg --install-new "$PLG/&plgNAME;.txz"; then
    echo "ERROR: installation of &plgNAME; failed."
    /etc/rc.d/rc.lldpd autostart
    exit 1
fi

echo "Removing superseded package files..."
for f in "$PLG"/*.txz "$PLG"/*.md5 "$PLG"/*.sha256; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in
        "&lldpdNAME;.txz"|"&plgNAME;.txz") ;;
        *) rm -f "$f" ;;
    esac
done

echo "Determining if LLDP service should be started..."
if ! /etc/rc.d/rc.lldpd autostart; then
    echo "WARNING: the LLDP service could not be started, see the syslog."
fi

echo ""
echo "-------------------------------------------------------------"
echo " LLDP for UNRAID has been installed."
echo " Version: &version; / Plugin Maintainer: &author;"
echo "-------------------------------------------------------------"
echo ""
exit 0
</INLINE>
</FILE>

<!--
definition for uninstallation of the plugin
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "Stopping LLDP service (before uninstall)..."
if [ -x /etc/rc.d/rc.lldpd ]; then
    /etc/rc.d/rc.lldpd stop
fi
killall lldpd >/dev/null 2>&amp;1

removepkg ulldpd
removepkg lldpd

# remove downloaded packages; the user configuration (ulldpd.cfg) is kept
rm -f &plgPATH;/*.txz &plgPATH;/*.md5 &plgPATH;/*.sha256
rm -rf &emhttp;
rm -rf /run/lldpd /run/lldpd.pid /run/lldpd.socket

echo ""
echo "-----------------------------------------------------------"
echo " LLDP for UNRAID has been removed."
echo " Version: &version; / Plugin Maintainer: &author;"
echo " Your settings were kept in &plgPATH;/&name;.cfg"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
