PROG="ulldpd"
PLGPATH="/boot/config/plugins/$PROG"
CONFIG="$PLGPATH/$PROG.cfg"
LLDPD="/usr/sbin/lldpd"
LLDPCLI="/usr/sbin/lldpcli"
PIDFILE="/run/lldpd.pid"
CHROOTDIR="/run/lldpd"

LLDPD_CONFD="/etc/lldpd.d"
GENERATED_CONF="$LLDPD_CONFD/ulldpd.conf"
CUSTOM_SRC="$PLGPATH/custom.conf"
CUSTOM_DST="$LLDPD_CONFD/zz-ulldpd-custom.conf"
CUSTOM_MAX=16384    # bytes; keep in sync with the settings page
WATCH="/usr/local/emhttp/plugins/ulldpd/scripts/watch"
POLL="/usr/local/emhttp/plugins/ulldpd/include/poll.php"
WATCH_PID="/run/ulldpd-watch.pid"
SYSNET="/sys/class/net"
MAX_PORTS=64

# Configuration defaults (only the keys below are ever read from the cfg file)
SERVICE="disable"
FORCE="disable"
CDP="disable"
FDP="disable"
SONMP="disable"
EDP="disable"
RXONLY="disable"
IFALIAS="disable"
IFACES="eth*"
MGMT_PATTERN=""
CHASSIS_IFACE=""
SYSNAME=""
SYSDESCR=""
TX_INTERVAL="30"
TX_HOLD="4"
PORTID_SUBTYPE="default"
PORTID_LOCAL=""
PORTDESCR=""
BOND_SRC_MAC="default"
# NOTIFY and NOTIFY_LEVEL are used by the PHP watcher; they are validated here only to warn about bad values
# shellcheck disable=SC2034
NOTIFY="disable"
# shellcheck disable=SC2034
NOTIFY_LEVEL="normal"
# per-port settings (interface name -> value), from PORT_STATUS_<if>, PORT_ID_<if>, PORT_DESCR_<if>
declare -A PORT_STATUS=() PORT_ID=() PORT_DESCRIPTION=() PORT_SEEN=()

# Validators: the same rules as ulldpd_valid() in include/ulldpd_config.php.
# Returns 0 if $2 is an acceptable value for key $1.
valid_value() {
    local key="$1" val="$2"
    case "$key" in
        SERVICE|FORCE|CDP|FDP|SONMP|EDP|RXONLY|IFALIAS|NOTIFY)
            [[ $val =~ ^(enable|disable)$ ]] ;;
        PORTID_SUBTYPE)
            [[ $val =~ ^(default|ifname|macaddress|local)$ ]] ;;
        BOND_SRC_MAC)
            [[ $val =~ ^(default|real|zero|fixed|local)$ ]] ;;
        NOTIFY_LEVEL)
            [[ $val =~ ^(normal|warning)$ ]] ;;
        PORT_STATUS_VALUE)
            [[ $val =~ ^(rx-and-tx|rx-only|tx-only|disabled)$ ]] ;;
        PORTID_LOCAL|PORT_ID_VALUE)
            valid_text "$val" 64 ;;
        PORTDESCR|PORT_DESCR_VALUE)
            valid_text "$val" 100 ;;
        IFACES)
            [[ $val =~ ^[A-Za-z0-9_.*,!-]{1,128}$ ]] ;;
        CHASSIS_IFACE)
            [[ $val =~ ^[A-Za-z0-9_.*,!-]{0,128}$ ]] ;;
        MGMT_PATTERN)
            [[ $val =~ ^[0-9A-Fa-f.:/*,!]{0,256}$ ]] ;;
        SYSNAME)
            [[ $val =~ ^[A-Za-z0-9._-]{0,63}$ ]] ;;
        SYSDESCR)
            [[ $val =~ ^[][A-Za-z0-9\ ._,:/\(\)+@%=~*-]{0,200}$ ]] ;;
        TX_INTERVAL)
            [[ $val =~ ^[0-9]{1,4}$ ]] && [ "$((10#$val))" -ge 1 ] && [ "$((10#$val))" -le 3600 ] ;;
        TX_HOLD)
            [[ $val =~ ^[0-9]{1,3}$ ]] && [ "$((10#$val))" -ge 1 ] && [ "$((10#$val))" -le 100 ] ;;
        *)
            return 1 ;;
    esac
}

# Free text for port ID / port description: printable subset, no quotes or
# newlines, no leading '-' or blank (it becomes an lldpcli argument), and '%'
# only as the %i (interface name) template. Same rule as ulldpd_text_valid().
valid_text() {
    local val="$1" max="$2"
    [ "${#val}" -le "$max" ] || return 1
    [[ $val =~ ^[][A-Za-z0-9\ ._,:/\(\)+@%=~*-]*$ ]] || return 1
    [[ $val != -* && $val != " "* ]] || return 1
    [[ $val =~ %[^i] || $val == *% ]] && return 1
    return 0
}

# Interface name usable as an lldpcli argument (same as ulldpd_ifname_valid())
valid_ifname() {
    [[ $1 =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,14}$ ]]
}

# Same matching rules as lldpd's interface pattern: "a,b,!c", "!!x" = always allow.
iface_selected() {
    local name="$1" patterns="$2" p
    local denied=0 found=1 pats=()
    IFS=, read -ra pats <<< "$patterns"
    # exclusion-only lists ("!eth2") match everything else
    for p in "${pats[@]}"; do
        if [ -n "$p" ] && [[ $p != '!'* ]]; then found=0; break; fi
    done
    # the patterns are globs on purpose (same as lldpd's fnmatch)
    # shellcheck disable=SC2053
    for p in "${pats[@]}"; do
        [ -n "$p" ] || continue
        if [[ $p == '!!'?* && $name == ${p:2} ]]; then return 0; fi
        if [[ $p == '!'?* && $name == ${p:1} ]]; then denied=1; found=0
        elif [ $denied -eq 0 ] && [[ $name == $p ]]; then found=1
        fi
    done
    [ $found -eq 1 ]
}

# The configuration lives on /boot and is user/web-writable: it is parsed as
# DATA (whitelisted keys, validated values) and never executed with "source".
# Invalid values are ignored (the default stays) with a warning.
load_config() {
    local line key val pfield pif
    [ -r "$CONFIG" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        [[ $line =~ ^[[:space:]]*([A-Za-z0-9_]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]])?[[:space:]]*$ ]] || continue
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        pfield=""
        case "$key" in
            SERVICE|FORCE|CDP|FDP|SONMP|EDP|RXONLY|IFALIAS|IFACES|MGMT_PATTERN|CHASSIS_IFACE|SYSNAME|SYSDESCR|TX_INTERVAL|TX_HOLD|PORTID_SUBTYPE|PORTID_LOCAL|PORTDESCR|BOND_SRC_MAC|NOTIFY|NOTIFY_LEVEL) ;;
            *)
                # per-port key: PORT_(STATUS|ID|DESCR)_<ifname, '.' written as _x2e_>
                [[ $key =~ ^PORT_(STATUS|ID|DESCR)_([A-Za-z0-9_-]{1,80})$ ]] || continue
                pfield="${BASH_REMATCH[1]}"
                pif="${BASH_REMATCH[2]//_x2e_/.}"
                valid_ifname "$pif" || continue
                ;;
        esac
        # strip one pair of matching surrounding quotes
        if [[ ${#val} -ge 2 && ( ( $val == \"*\" ) || ( $val == \'*\' ) ) ]]; then
            val="${val:1:${#val}-2}"
        fi
        if [ -n "$pfield" ]; then
            if valid_value "PORT_${pfield}_VALUE" "$val"; then
                if [ -z "${PORT_SEEN[$pif]+x}" ]; then
                    [ "${#PORT_SEEN[@]}" -lt "$MAX_PORTS" ] || continue
                    PORT_SEEN[$pif]=1
                fi
                case "$pfield" in
                    STATUS) PORT_STATUS[$pif]="$val" ;;
                    ID)     PORT_ID[$pif]="$val" ;;
                    DESCR)  PORT_DESCRIPTION[$pif]="$val" ;;
                esac
            else
                echo "WARNING: ignoring invalid value for $key in $CONFIG." >&2
            fi
        elif valid_value "$key" "$val"; then
            printf -v "$key" '%s' "$val"
        else
            echo "WARNING: ignoring invalid value for $key in $CONFIG (using the default)." >&2
        fi
    done < "$CONFIG"
    [ -n "$IFACES" ] || IFACES="eth*"
    # a global local port ID needs the %i template, otherwise every port would get the same ID
    if [ "$PORTID_SUBTYPE" == "local" ] && [[ $PORTID_LOCAL != *%i* ]]; then
        echo "WARNING: PORTID_SUBTYPE=local needs a PORTID_LOCAL containing %i; using the default port ID subtype." >&2
        PORTID_SUBTYPE="default"
    fi
}

# Write /etc/lldpd.d/ulldpd.conf (lldpcli syntax) from the validated values and
# install the optional user supplied custom configuration next to it.
write_lldpd_conf() {
    local tmp
    mkdir -p "$LLDPD_CONFD" || return 1
    rm -f "$GENERATED_CONF" "$CUSTOM_DST"
    tmp="$(mktemp "$LLDPD_CONFD/.ulldpd.XXXXXX")" || return 1
    {
        echo "# generated by the ulldpd plugin from $CONFIG - do not edit"
        echo "configure lldp tx-interval $((10#$TX_INTERVAL))"
        echo "configure lldp tx-hold $((10#$TX_HOLD))"
        [ -n "$SYSNAME" ] && echo "configure system hostname \"$SYSNAME\""
        [ -n "$MGMT_PATTERN" ] && echo "configure system ip management pattern \"$MGMT_PATTERN\""
        [ "$IFALIAS" == "enable" ] && echo "configure system interface description"
        [ "$BOND_SRC_MAC" != "default" ] && echo "configure system bond-slave-src-mac-type $BOND_SRC_MAC"
        write_port_conf
    } > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$GENERATED_CONF" || { rm -f "$tmp"; return 1; }

    if [ -f "$CUSTOM_SRC" ]; then
        if custom_conf_ok "$CUSTOM_SRC"; then
            cp "$CUSTOM_SRC" "$CUSTOM_DST" && chmod 644 "$CUSTOM_DST"
            echo "Using custom lldpd configuration $CUSTOM_SRC"
        else
            echo "WARNING: $CUSTOM_SRC is not valid (too large, not plain ASCII, or not only configure/unconfigure commands); ignored." >&2
        fi
    fi
    return 0
}

# Port ID / description / status commands (validated values only; the interface
# names come from /sys/class/net and the cfg and match valid_ifname). Written to
# stdout as lldpcli commands.
write_port_conf() {
    local d n if_list=() pif txt id descr count=0
    case "$PORTID_SUBTYPE" in
        ifname|macaddress) echo "configure lldp portidsubtype $PORTID_SUBTYPE" ;;
    esac
    [ -n "$PORTDESCR" ] && [[ $PORTDESCR != *%i* ]] && echo "configure lldp portdescription \"$PORTDESCR\""
    # interfaces that exist and are selected by the interface pattern, plus those with explicit settings
    for d in "$SYSNET"/*; do
        n="${d##*/}"
        valid_ifname "$n" || continue
        iface_selected "$n" "$IFACES" || continue
        if_list+=("$n")
        count=$((count + 1))
        [ $count -ge $MAX_PORTS ] && break
    done
    for pif in "${!PORT_STATUS[@]}" "${!PORT_ID[@]}" "${!PORT_DESCRIPTION[@]}"; do
        [ -e "$SYSNET/$pif" ] || continue
        [[ " ${if_list[*]} " == *" $pif "* ]] || if_list+=("$pif")
    done
    for n in "${if_list[@]}"; do
        id=""
        descr=""
        if [ -n "${PORT_ID[$n]:-}" ]; then
            id="${PORT_ID[$n]}"
        elif [ "$PORTID_SUBTYPE" == "local" ]; then
            id="$PORTID_LOCAL"
        fi
        if [ -n "${PORT_DESCRIPTION[$n]:-}" ]; then
            descr="${PORT_DESCRIPTION[$n]}"
        elif [ -n "$PORTDESCR" ] && [[ $PORTDESCR == *%i* ]]; then
            descr="$PORTDESCR"
        fi
        # the port ID subtype "local" resets the description, so the description comes second
        [ -n "$id" ] && echo "configure ports $n lldp portidsubtype local \"${id//%i/$n}\""
        [ -n "$descr" ] && echo "configure ports $n lldp portdescription \"${descr//%i/$n}\""
        txt="${PORT_STATUS[$n]:-rx-and-tx}"
        [ "$txt" != "rx-and-tx" ] && echo "configure ports $n lldp status $txt"
    done
    return 0
}

# custom.conf: <= CUSTOM_MAX bytes, printable ASCII (+tab/newline), and every
# line is blank, a # comment, or a configure/unconfigure command.
custom_conf_ok() {
    local f="$1" line
    [ "$(wc -c < "$f")" -le "$CUSTOM_MAX" ] || return 1
    LC_ALL=C grep -q '[^[:print:][:space:]]' "$f" && return 1
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        [[ $line =~ ^[[:space:]]*(#.*|(un)?configure([[:space:]].*)?)?$ ]] || return 1
    done < "$f"
    return 0
}

# PID of the running daemon (pid file + executable identity), empty if none
lldpd_pid() {
    local pid exe
    [ -r "$PIDFILE" ] || return 1
    pid="$(head -n1 "$PIDFILE" 2>/dev/null)"
    [[ $pid =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 1
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)" || return 1
    exe="${exe% (deleted)}"
    [ "${exe##*/}" == "lldpd" ] || return 1
    echo "$pid"
}

lldpd_running() {
    lldpd_pid >/dev/null
}

# PID of the running neighbour watcher (pid file + command line identity), empty if none
watch_pid() {
    local pid
    [ -r "$WATCH_PID" ] || return 1
    pid="$(head -n1 "$WATCH_PID" 2>/dev/null)"
    [[ $pid =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 1
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -qF "$WATCH" || return 1
    echo "$pid"
}

watch_start() {
    watch_pid >/dev/null && return 0
    [ -x "$WATCH" ] && [ -x /usr/bin/php ] || return 0
    rm -f "$WATCH_PID"
    setsid "$WATCH" >/dev/null 2>&1 </dev/null &
    for _ in $(seq 1 10); do
        watch_pid >/dev/null && return 0
        sleep 0.2
    done
    echo "WARNING: the neighbor watcher did not start." >&2
    return 0
}

# stop the watcher and write the pending neighbour history to /boot
watch_stop() {
    local pid
    pid="$(watch_pid)" && kill -TERM "$pid" 2>/dev/null
    rm -f "$WATCH_PID"
    [ -f "$POLL" ] && [ -x /usr/bin/php ] && timeout 30 /usr/bin/php -q "$POLL" --reset >/dev/null 2>&1
    return 0
}

lldpd_start() {
    local args=() out rc

    if lldpd_running; then
        echo "LLDP service is already running (pid $(lldpd_pid))."
        watch_start
        return 0
    fi
    if [ ! -x "$LLDPD" ]; then
        echo "ERROR: $LLDPD not found; the lldpd package is not installed." >&2
        return 1
    fi

    load_config
    [ "$FORCE" == "enable" ] && args+=(-l)
    [ "$CDP" == "enable" ] && args+=(-c)
    [ "$FDP" == "enable" ] && args+=(-f)
    [ "$SONMP" == "enable" ] && args+=(-s)
    [ "$EDP" == "enable" ] && args+=(-e)
    [ "$RXONLY" == "enable" ] && args+=(-r)
    args+=(-I "$IFACES")
    [ -n "$CHASSIS_IFACE" ] && args+=(-C "$CHASSIS_IFACE")
    [ -n "$SYSDESCR" ] && args+=(-S "$SYSDESCR")
    write_lldpd_conf || { echo "ERROR: could not write $GENERATED_CONF." >&2; return 1; }

    echo "Starting LLDP service with parameters: ${args[*]}"
    mkdir -p "$CHROOTDIR"
    rm -f "$PIDFILE"

    out="$(mktemp)" || return 1
    "$LLDPD" "${args[@]}" >"$out" 2>&1
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "ERROR: lldpd failed to start (exit code $rc):" >&2
        cat "$out" >&2
        rm -f "$out"
        return $rc
    fi

    # readiness: daemon alive (pid + exe) and answering on its control socket
    for _ in $(seq 1 20); do
        if lldpd_running && timeout 5 "$LLDPCLI" show chassis >/dev/null 2>&1; then
            [ -s "$out" ] && cat "$out"
            rm -f "$out"
            echo "LLDP service is running (pid $(lldpd_pid))."
            watch_start
            return 0
        fi
        sleep 0.5
    done

    echo "ERROR: lldpd was started but is not ready (no pid file or no answer from lldpcli)." >&2
    cat "$out" >&2
    rm -f "$out"
    return 1
}

lldpd_stop() {
    local pid
    watch_stop
    pid="$(lldpd_pid)"
    if [ -n "$pid" ]; then
        kill -TERM "$pid" 2>/dev/null
        for _ in $(seq 1 20); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.5
        done
        kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
    fi
    # leftovers (older plugin versions kept the pid file elsewhere)
    if pgrep -x lldpd >/dev/null 2>&1; then
        pkill -TERM -x lldpd 2>/dev/null
        for _ in $(seq 1 10); do
            pgrep -x lldpd >/dev/null 2>&1 || break
            sleep 0.5
        done
        pkill -KILL -x lldpd 2>/dev/null
    fi
    rm -f "$PIDFILE" /run/lldpd.socket
    if pgrep -x lldpd >/dev/null 2>&1; then
        echo "ERROR: lldpd could not be stopped." >&2
        return 1
    fi
    echo "LLDP service is stopped."
    return 0
}

lldpd_restart() {
    lldpd_stop || return $?
    lldpd_start
}

lldpd_status() {
    local pid wpid
    if pid="$(lldpd_pid)"; then
        echo "LLDP service is running (pid $pid)."
        if wpid="$(watch_pid)"; then echo "Neighbor watcher is running (pid $wpid)."; else echo "Neighbor watcher is not running."; fi
        return 0
    fi
    echo "LLDP service is not running."
    return 3
}

# start only when enabled in the configuration (used after plugin install/boot)
lldpd_autostart() {
    load_config
    if [ "$SERVICE" == "enable" ]; then
        lldpd_start
    else
        echo "LLDP service is disabled in the configuration; not starting."
        return 0
    fi
}

case "$1" in
  'start')
    lldpd_start
  ;;
  'stop')
    lldpd_stop
  ;;
  'restart')
    lldpd_restart
  ;;
  'status')
    lldpd_status
  ;;
  'autostart')
    lldpd_autostart
  ;;
  *)
    echo "Usage: $0 start|stop|restart|status|autostart" >&2
    exit 2
  ;;
esac
exit $?
