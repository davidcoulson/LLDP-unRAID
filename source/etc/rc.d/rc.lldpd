PROG="ulldpd"
PLGPATH="/boot/config/plugins/$PROG"
CONFIG="$PLGPATH/$PROG.cfg"
LLDPD="/usr/sbin/lldpd"
LLDPCLI="/usr/sbin/lldpcli"
PIDFILE="/run/lldpd.pid"
CHROOTDIR="/run/lldpd"

LLDPD_CONFD="/etc/lldpd.d"
GENERATED_CONF="$LLDPD_CONFD/ulldpd.conf"
CUSTOM_SRC="$PLGPATH/custom.conf"
CUSTOM_DST="$LLDPD_CONFD/zz-ulldpd-custom.conf"
CUSTOM_MAX=16384    # bytes; keep in sync with the settings page

# Configuration defaults (only the keys below are ever read from the cfg file)
SERVICE="disable"
FORCE="disable"
CDP="disable"
FDP="disable"
SONMP="disable"
EDP="disable"
RXONLY="disable"
IFALIAS="disable"
IFACES="eth*"
MGMT_PATTERN=""
CHASSIS_IFACE=""
SYSNAME=""
SYSDESCR=""
TX_INTERVAL="30"
TX_HOLD="4"

# Validators: the same rules as ulldpd_valid() in include/ulldpd_config.php.
# Returns 0 if $2 is an acceptable value for key $1.
valid_value() {
    local key="$1" val="$2"
    case "$key" in
        SERVICE|FORCE|CDP|FDP|SONMP|EDP|RXONLY|IFALIAS)
            [[ $val =~ ^(enable|disable)$ ]] ;;
        IFACES)
            [[ $val =~ ^[A-Za-z0-9_.*,!-]{1,128}$ ]] ;;
        CHASSIS_IFACE)
            [[ $val =~ ^[A-Za-z0-9_.*,!-]{0,128}$ ]] ;;
        MGMT_PATTERN)
            [[ $val =~ ^[0-9A-Fa-f.:/*,!]{0,256}$ ]] ;;
        SYSNAME)
            [[ $val =~ ^[A-Za-z0-9._-]{0,63}$ ]] ;;
        SYSDESCR)
            [[ $val =~ ^[][A-Za-z0-9\ ._,:/\(\)+@%=~*-]{0,200}$ ]] ;;
        TX_INTERVAL)
            [[ $val =~ ^[0-9]{1,4}$ ]] && [ "$((10#$val))" -ge 1 ] && [ "$((10#$val))" -le 3600 ] ;;
        TX_HOLD)
            [[ $val =~ ^[0-9]{1,3}$ ]] && [ "$((10#$val))" -ge 1 ] && [ "$((10#$val))" -le 100 ] ;;
        *)
            return 1 ;;
    esac
}

# The configuration lives on /boot and is user/web-writable: it is parsed as
# DATA (whitelisted keys, validated values) and never executed with "source".
# Invalid values are ignored (the default stays) with a warning.
load_config() {
    local line key val
    [ -r "$CONFIG" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        [[ $line =~ ^[[:space:]]*([A-Z_]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]])?[[:space:]]*$ ]] || continue
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        case "$key" in
            SERVICE|FORCE|CDP|FDP|SONMP|EDP|RXONLY|IFALIAS|IFACES|MGMT_PATTERN|CHASSIS_IFACE|SYSNAME|SYSDESCR|TX_INTERVAL|TX_HOLD) ;;
            *) continue ;;
        esac
        # strip one pair of matching surrounding quotes
        if [[ ${#val} -ge 2 && ( ( $val == \"*\" ) || ( $val == \'*\' ) ) ]]; then
            val="${val:1:${#val}-2}"
        fi
        if valid_value "$key" "$val"; then
            printf -v "$key" '%s' "$val"
        else
            echo "WARNING: ignoring invalid value for $key in $CONFIG (using the default)." >&2
        fi
    done < "$CONFIG"
    [ -n "$IFACES" ] || IFACES="eth*"
}

# Write /etc/lldpd.d/ulldpd.conf (lldpcli syntax) from the validated values and
# install the optional user supplied custom configuration next to it.
write_lldpd_conf() {
    local tmp
    mkdir -p "$LLDPD_CONFD" || return 1
    rm -f "$GENERATED_CONF" "$CUSTOM_DST"
    tmp="$(mktemp "$LLDPD_CONFD/.ulldpd.XXXXXX")" || return 1
    {
        echo "# generated by the ulldpd plugin from $CONFIG - do not edit"
        echo "configure lldp tx-interval $((10#$TX_INTERVAL))"
        echo "configure lldp tx-hold $((10#$TX_HOLD))"
        [ -n "$SYSNAME" ] && echo "configure system hostname \"$SYSNAME\""
        [ -n "$MGMT_PATTERN" ] && echo "configure system ip management pattern \"$MGMT_PATTERN\""
        [ "$IFALIAS" == "enable" ] && echo "configure system interface description"
    } > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$GENERATED_CONF" || { rm -f "$tmp"; return 1; }

    if [ -f "$CUSTOM_SRC" ]; then
        if custom_conf_ok "$CUSTOM_SRC"; then
            cp "$CUSTOM_SRC" "$CUSTOM_DST" && chmod 644 "$CUSTOM_DST"
            echo "Using custom lldpd configuration $CUSTOM_SRC"
        else
            echo "WARNING: $CUSTOM_SRC is not valid (too large, not plain ASCII, or not only configure/unconfigure commands); ignored." >&2
        fi
    fi
    return 0
}

# custom.conf: <= CUSTOM_MAX bytes, printable ASCII (+tab/newline), and every
# line is blank, a # comment, or a configure/unconfigure command.
custom_conf_ok() {
    local f="$1" line
    [ "$(wc -c < "$f")" -le "$CUSTOM_MAX" ] || return 1
    LC_ALL=C grep -q '[^[:print:][:space:]]' "$f" && return 1
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        [[ $line =~ ^[[:space:]]*(#.*|(un)?configure([[:space:]].*)?)?$ ]] || return 1
    done < "$f"
    return 0
}

# PID of the running daemon (pid file + executable identity), empty if none
lldpd_pid() {
    local pid exe
    [ -r "$PIDFILE" ] || return 1
    pid="$(head -n1 "$PIDFILE" 2>/dev/null)"
    [[ $pid =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 1
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)" || return 1
    exe="${exe% (deleted)}"
    [ "${exe##*/}" == "lldpd" ] || return 1
    echo "$pid"
}

lldpd_running() {
    lldpd_pid >/dev/null
}

lldpd_start() {
    local args=() out rc

    if lldpd_running; then
        echo "LLDP service is already running (pid $(lldpd_pid))."
        return 0
    fi
    if [ ! -x "$LLDPD" ]; then
        echo "ERROR: $LLDPD not found; the lldpd package is not installed." >&2
        return 1
    fi

    load_config
    [ "$FORCE" == "enable" ] && args+=(-l)
    [ "$CDP" == "enable" ] && args+=(-c)
    [ "$FDP" == "enable" ] && args+=(-f)
    [ "$SONMP" == "enable" ] && args+=(-s)
    [ "$EDP" == "enable" ] && args+=(-e)
    [ "$RXONLY" == "enable" ] && args+=(-r)
    args+=(-I "$IFACES")
    [ -n "$CHASSIS_IFACE" ] && args+=(-C "$CHASSIS_IFACE")
    [ -n "$SYSDESCR" ] && args+=(-S "$SYSDESCR")
    write_lldpd_conf || { echo "ERROR: could not write $GENERATED_CONF." >&2; return 1; }

    echo "Starting LLDP service with parameters: ${args[*]}"
    mkdir -p "$CHROOTDIR"
    rm -f "$PIDFILE"

    out="$(mktemp)" || return 1
    "$LLDPD" "${args[@]}" >"$out" 2>&1
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "ERROR: lldpd failed to start (exit code $rc):" >&2
        cat "$out" >&2
        rm -f "$out"
        return $rc
    fi

    # readiness: daemon alive (pid + exe) and answering on its control socket
    for _ in $(seq 1 20); do
        if lldpd_running && timeout 5 "$LLDPCLI" show chassis >/dev/null 2>&1; then
            [ -s "$out" ] && cat "$out"
            rm -f "$out"
            echo "LLDP service is running (pid $(lldpd_pid))."
            return 0
        fi
        sleep 0.5
    done

    echo "ERROR: lldpd was started but is not ready (no pid file or no answer from lldpcli)." >&2
    cat "$out" >&2
    rm -f "$out"
    return 1
}

lldpd_stop() {
    local pid
    pid="$(lldpd_pid)"
    if [ -n "$pid" ]; then
        kill -TERM "$pid" 2>/dev/null
        for _ in $(seq 1 20); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.5
        done
        kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
    fi
    # leftovers (older plugin versions kept the pid file elsewhere)
    if pgrep -x lldpd >/dev/null 2>&1; then
        pkill -TERM -x lldpd 2>/dev/null
        for _ in $(seq 1 10); do
            pgrep -x lldpd >/dev/null 2>&1 || break
            sleep 0.5
        done
        pkill -KILL -x lldpd 2>/dev/null
    fi
    rm -f "$PIDFILE" /run/lldpd.socket
    if pgrep -x lldpd >/dev/null 2>&1; then
        echo "ERROR: lldpd could not be stopped." >&2
        return 1
    fi
    echo "LLDP service is stopped."
    return 0
}

lldpd_restart() {
    lldpd_stop || return $?
    lldpd_start
}

lldpd_status() {
    local pid
    if pid="$(lldpd_pid)"; then
        echo "LLDP service is running (pid $pid)."
        return 0
    fi
    echo "LLDP service is not running."
    return 3
}

# start only when enabled in the configuration (used after plugin install/boot)
lldpd_autostart() {
    load_config
    if [ "$SERVICE" == "enable" ]; then
        lldpd_start
    else
        echo "LLDP service is disabled in the configuration; not starting."
        return 0
    fi
}

case "$1" in
  'start')
    lldpd_start
  ;;
  'stop')
    lldpd_stop
  ;;
  'restart')
    lldpd_restart
  ;;
  'status')
    lldpd_status
  ;;
  'autostart')
    lldpd_autostart
  ;;
  *)
    echo "Usage: $0 start|stop|restart|status|autostart" >&2
    exit 2
  ;;
esac
exit $?
