    <?
    ulldpd_sel($ulldpd_cfg, 'FORCE', 'Force LLDP Protocol', '<p>Force to send LLDP packets even when there is no LLDP peer detected but there is a peer speaking another protocol detected.</p><p>By default (= <strong>\'No\'</strong>), LLDP packets are sent when there is a peer speaking LLDP detected or when there is no peer at all.</p>');
    ulldpd_sel($ulldpd_cfg, 'CDP', 'Enable CDP Protocol', '<p>CDP (Cisco Discovery Protocol): also send and understand Cisco\'s proprietary discovery frames, so Cisco routers and switches that do not speak LLDP can see this server and show up as neighbors.</p>');
    ulldpd_sel($ulldpd_cfg, 'FDP', 'Enable FDP Protocol', '<p>FDP (Foundry Discovery Protocol): the same for Foundry (now Brocade/Ruckus) network gear that does not speak LLDP.</p>');
    ulldpd_sel($ulldpd_cfg, 'SONMP', 'Enable SONMP Protocol', '<p>SONMP (SynOptics Network Management Protocol): the same for Nortel (now Avaya) routers and switches that do not speak LLDP.</p>');
    ulldpd_sel($ulldpd_cfg, 'EDP', 'Enable EDP Protocol', '<p>EDP (Extreme Discovery Protocol): the same for Extreme Networks routers and switches that do not speak LLDP.</p><p>Enable the legacy protocols only if your network equipment needs them; the neighbor table shows which protocol each neighbor used.</p>');
    ulldpd_sel($ulldpd_cfg, 'RXONLY', 'Receive-only Mode', '<p>When <strong>\'Yes\'</strong> this server listens for neighbors but never transmits LLDP frames (lldpd option <code>-r</code>).</p>');
    ulldpd_sel($ulldpd_cfg, 'IFALIAS', 'Update Interface Descriptions', '<p>When <strong>\'Yes\'</strong> lldpd sets each interface\'s description (ifAlias) to the name of the neighbor found on it, or to the number of neighbors.</p>');
    ulldpd_txt($ulldpd_cfg, 'IFACES', 'Interface Pattern', '<p>Comma separated list of interfaces to use; wildcards (<code>*</code>) are allowed, and a leading <code>!</code> excludes an interface, e.g. <code>eth*,!eth2</code>. Default: <code>eth*</code>. Allowed characters: letters, digits and <code>_ . * , ! -</code>.</p>', '[A-Za-z0-9_.*,!\-]{1,128}', 128, 'eth*');
    ulldpd_txt($ulldpd_cfg, 'MGMT_PATTERN', 'Management Address Pattern', '<p>Which of this server\'s addresses are advertised as management addresses (comma separated, wildcards and <code>!</code> exclusions allowed). Without it the first IPv4 and IPv6 address are used. Example to leave out the Tailscale IPv6 address: <code>!fd7a:115c:a1e0:*</code>; to remove all IPv6 addresses: <code>!*:*</code>. Only hexadecimal digits and <code>. : / * , !</code> are accepted. Leave empty for the default.</p>', '[0-9A-Fa-f.:\/*,!]{0,256}', 256, '!fd7a:115c:a1e0:*');
    ulldpd_txt($ulldpd_cfg, 'CHASSIS_IFACE', 'Interface for Chassis ID', '<p>Interface (or pattern) whose MAC address is used to compute the chassis ID advertised to neighbors. Leave empty for the default. Same allowed characters as the interface pattern.</p>', '[A-Za-z0-9_.*,!\-]{0,128}', 128, 'eth0');
    ulldpd_txt($ulldpd_cfg, 'SYSNAME', 'System Name Override', '<p>Name advertised to neighbors instead of the server\'s hostname. Letters, digits, <code>. _ -</code>, up to 63 characters. Leave empty to use the hostname.</p>', '[A-Za-z0-9._\-]{0,63}', 63, '');
    ulldpd_txt($ulldpd_cfg, 'SYSDESCR', 'System Description Override', '<p>Description advertised to neighbors instead of the default (Unraid version and kernel). Printable text up to 200 characters; quotes, backslashes, <code>$ ` ; # | &amp; &lt; &gt;</code> and line breaks are not allowed. Leave empty for the default.</p>', '[A-Za-z0-9 ._,:\/\(\)+@%=~*\[\]\-]{0,200}', 200, '');
    ulldpd_enum($ulldpd_cfg, 'PORTID_SUBTYPE', 'Port ID Subtype', '<p>What this server advertises as its port ID on every port. <strong>Default</strong> lets lldpd choose (the interface MAC address, or the interface name when an interface description is set). <strong>ifname</strong> = interface name (eth0), <strong>macaddress</strong> = the interface MAC address, <strong>local</strong> = the text below (it must contain <code>%i</code>, which becomes the interface name, so every port gets a different ID). A per-port override can be set in the Ports table. lldpd 1.0.22 has no &quot;interface alias&quot; subtype, and only <em>local</em> can be set for a single port.</p>', ['default' => 'Default', 'ifname' => 'ifname (interface name)', 'macaddress' => 'macaddress', 'local' => 'local (text below)']);
    ulldpd_txt($ulldpd_cfg, 'PORTID_LOCAL', 'Local Port ID Text', '<p>Used when the port ID subtype is <strong>local</strong>, e.g. <code>unraid-%i</code>. Letters, digits and <code>space . _ , : / ( ) + @ = ~ * [ ] -</code>, up to 64 characters; <code>%i</code> is the only allowed <code>%</code> sequence; must not start with <code>-</code> or a space; no quotes or line breaks.</p>', '[A-Za-z0-9 ._,:\/()+@%=~*\[\]\-]{0,64}', 64, 'unraid-%i');
    ulldpd_txt($ulldpd_cfg, 'PORTDESCR', 'Port Description', '<p>Port description advertised on every port instead of the default (the interface name). <code>%i</code> is replaced by the interface name, e.g. <code>Unraid %i</code>. Same allowed characters as the local port ID text, up to 100 characters. Leave empty for the default. Can be overridden per port in the Ports table.</p>', '[A-Za-z0-9 ._,:\/()+@%=~*\[\]\-]{0,100}', 100, 'Unraid %i');
    ulldpd_enum($ulldpd_cfg, 'BOND_SRC_MAC', 'Source MAC on Bond Slaves', '<p>Source MAC address of LLDP frames sent on the members (slaves) of a bond. <strong>Default</strong> keeps lldpd\'s default (<em>local</em>). <strong>real</strong> = the slave\'s own MAC, <strong>zero</strong> = 00:00:00:00:00:00, <strong>fixed</strong> = a fixed value (00:60:08:69:97:ef), <strong>local</strong> = the real MAC with the locally-administered bit set. Some switches complain about <em>zero</em> or <em>fixed</em> (invalid or flapping MAC); <em>local</em> could in theory duplicate another MAC. Only matters with bonding/LACP.</p>', ['default' => 'Default (local)', 'real' => 'real', 'zero' => 'zero', 'fixed' => 'fixed', 'local' => 'local']);
    ulldpd_txt($ulldpd_cfg, 'TX_INTERVAL', 'Transmit Interval (seconds)', '<p>Seconds between two LLDP frames, 1 to 3600. Default: 30.</p>', '[0-9]{1,4}', 4, '30');
    ulldpd_txt($ulldpd_cfg, 'TX_HOLD', 'Transmit Hold', '<p>Multiplier of the transmit interval used as the time-to-live of sent frames, 1 to 100. Default: 4 (TTL 120 seconds).</p>', '[0-9]{1,3}', 3, '4');
    ?>

    <?
    ulldpd_sel($ulldpd_cfg, 'NOTIFY', 'Neighbor Change Notifications', '<p>When <strong>\'Yes\'</strong> an Unraid notification is sent when a neighbor appears, disappears or changes (system name or port ID). Default: No. To avoid floods from a flapping link at most 5 notifications are sent per 10 minutes (one per interface and kind every 2 minutes); the rest is summarised in one notification. A neighbor must be gone for 60 seconds before it counts as removed. Changes are always recorded in the history below the neighbor table, whatever this setting is.</p>');
    ulldpd_enum($ulldpd_cfg, 'NOTIFY_LEVEL', 'Notification Importance', '<p>Importance of the neighbor change notifications: normal or warning.</p>', ['normal' => 'Normal', 'warning' => 'Warning']);
    ?>

