        <p><strong>For advanced users.</strong> Extra <code>lldpcli</code> commands (one <code>configure ...</code> or <code>unconfigure ...</code> command per line, <code># comments</code> allowed; see <code>man lldpcli</code>) stored in <code>/boot/config/plugins/ulldpd/custom.conf</code> and copied to <code>/etc/lldpd.d/</code> when the service starts. They are applied after the settings above and can override them. Plain ASCII only, up to <?=ULLDPD_CUSTOM_MAX;?> bytes. Saving does not restart the service: use <strong>Restart LLDP</strong> to apply. An empty text removes the file.</p>
    </blockquote>
</form>

<script>
var ulldpdRunning = <?=json_encode($ulldpd_snap['running']);?>;
var ulldpdCsrf = <?=json_encode($var['csrf_token'] ?? '');?>;
function checkRUNNING(){
    // protocol controls stay enabled (disabled controls are not POSTed and would be
    // dropped from the configuration); Apply restarts a running service
    if ($('#SERVICE').val() === 'enable')
        $('#command').val('/usr/local/emhttp/plugins/ulldpd/scripts/' + (ulldpdRunning ? 'restart' : 'start'));
    else
        $('#command').val('/usr/local/emhttp/plugins/ulldpd/scripts/stop');
    $('#RESTART').prop('disabled', !ulldpdRunning);
}
function Restart() {
    $('#command').val('/usr/local/emhttp/plugins/ulldpd/scripts/restart');
}
// all HTML below is escaped server-side (include/status.php)
function ulldpdRefresh() {
    if (document.hidden) return;
    $.post('/plugins/ulldpd/include/status.php', {what: 'all', csrf_token: ulldpdCsrf}, function(d) {
        if (!d || d.error) return;
        ulldpdRunning = !!d.running;
        $('#ulldpd-status').html(d.status);
        $('#ulldpd-neighbors').html(d.neighbors);
        if (typeof d.history === 'string') $('#ulldpd-history').html(d.history);
        ulldpdApplyOpen();
        $('#ulldpd-chassis').html(d.chassis);
        checkRUNNING();
    }, 'json');
}
// expanded detail rows survive the periodic table refresh
var ulldpdOpen = {};
function ulldpdApplyOpen() {
    $('#ulldpd-neighbors tr.ulldpd-det').each(function() {
        var n = $(this).attr('data-if');
        var open = ulldpdOpen[n] === true;
        $(this).toggle(open);
        $('#ulldpd-neighbors a.ulldpd-tog').filter(function() { return $(this).attr('data-if') === n; })
            .find('i').attr('class', open ? 'fa fa-minus-square-o' : 'fa fa-plus-square-o');
    });
}
function ulldpdClearHistory() {
    if (!confirm('Clear the recorded neighbor changes?')) return;
    $.post('/plugins/ulldpd/include/history.php', {action: 'clear', csrf_token: ulldpdCsrf}, function(d) {
        $('#ulldpd-history-msg').text(d && d.message ? d.message : 'Cleared.');
        if (d && typeof d.history === 'string') $('#ulldpd-history').html(d.history);
        ulldpdRefresh();
    }, 'json').fail(function(x) {
        var m = 'Clear failed.';
        try { m = JSON.parse(x.responseText).error || m; } catch (e) {}
        $('#ulldpd-history-msg').text(m);
    });
}
function ulldpdSaveCustom() {
    $('#ulldpd-custom-msg').text('Saving...');
    $.post('/plugins/ulldpd/include/save_custom.php', {content: $('#ulldpd-custom').val(), csrf_token: ulldpdCsrf}, 'json')
        .done(function(d) { $('#ulldpd-custom-msg').text(d && d.message ? d.message : 'Saved.'); })
        .fail(function(x) {
            var m = 'Save failed.';
            try { m = JSON.parse(x.responseText).error || m; } catch (e) {}
            $('#ulldpd-custom-msg').text(m);
        });
}
$(function() {
    $('#SERVICE').change(checkRUNNING);
    $('#RESTART').click(Restart);
    $('#ulldpd-refresh').click(ulldpdRefresh);
    $('#ulldpd-custom-save').click(ulldpdSaveCustom);
    $('#ulldpd-history-clear').click(ulldpdClearHistory);
    $(document).on('click', 'a.ulldpd-tog', function(e) {
        e.preventDefault();
        var n = $(this).attr('data-if');
        ulldpdOpen[n] = !ulldpdOpen[n];
        ulldpdApplyOpen();
    });
    // "Default" also resets the per-port fields (the default.cfg handling only knows the global keys)
    $('#DEFAULT').click(function() {
        $('#ulldpd-ports select.ulldpd-port-status').each(function() { $(this).val($(this).attr('data-default')); });
        $('#ulldpd-ports input.ulldpd-port-text').val('');
    });

    checkRUNNING();
    setInterval(ulldpdRefresh, 10000);

    showStatus('lldpd');

    if ( typeof caPluginUpdateCheck === "function" ) {
        caPluginUpdateCheck("ulldpd.plg",{name:"LLDP"});
    }
});
</script>
