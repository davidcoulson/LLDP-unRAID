<script>
var ulldpdRunning = <?=json_encode($ulldpd_running);?>;
function checkRUNNING(){
    // protocol controls stay enabled (disabled controls are not POSTed and would be
    // dropped from the configuration); changes are applied by restarting a running service
    if ($('#SERVICE').val() === 'enable')
        $('#command').val('/usr/local/emhttp/plugins/ulldpd/scripts/' + (ulldpdRunning ? 'restart' : 'start'));
    else
        $('#command').val('/usr/local/emhttp/plugins/ulldpd/scripts/stop');
    $('#RESTART').prop('disabled', !ulldpdRunning);
    $('#SHOWNBS').prop('disabled', !ulldpdRunning);
}
function Restart() {
    $('#command').val('/usr/local/emhttp/plugins/ulldpd/scripts/restart');
}
function ShowNBS() {
    openBox('/usr/local/emhttp/plugins/ulldpd/scripts/shownbs', 'LLDP Neighbors', 600, 600, false);
}
$(function() {
    $('#btnApply').click(function(){
        $('#ulldpd-settings').submit();
    });

    $('#SERVICE').change(checkRUNNING);

    $('#RESTART').click(Restart);
    $('#SHOWNBS').click(ShowNBS);

    checkRUNNING();

    showStatus('lldpd');

    if ( typeof caPluginUpdateCheck === "function" ) {
        caPluginUpdateCheck("ulldpd.plg",{name:"LLDP"});
    }
});
</script>
