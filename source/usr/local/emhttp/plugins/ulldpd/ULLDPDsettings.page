function ulldpd_sel($cfg, $key, $label, $help) {
    $v = $cfg[$key];
    echo "<dl><dt>" . $label . ":</dt><dd><select id=\"$key\" name=\"$key\" size=\"1\">"
       . mk_option($v, 'disable', 'No') . mk_option($v, 'enable', 'Yes')
       . "</select></dd></dl>\n<blockquote class=\"inline_help\">" . $help . "</blockquote>\n";
}
function ulldpd_txt($cfg, $key, $label, $help, $pattern, $max, $placeholder = '') {
    echo "<dl><dt>" . $label . ":</dt><dd><input type=\"text\" id=\"$key\" name=\"$key\" class=\"narrow\" style=\"width:30em\" maxlength=\"$max\" pattern=\""
       . ulldpd_h($pattern) . "\" placeholder=\"" . ulldpd_h($placeholder) . "\" value=\"" . ulldpd_h($cfg[$key]) . "\"></dd></dl>\n<blockquote class=\"inline_help\">" . $help . "</blockquote>\n";
}
?>

<span style="float:right;margin-right:10px"><a href="https://github.com/davidcoulson/LLDP-unRAID/issues" target="_blank" title="LLDP Support (GitHub issues)"><i class="fa fa-medkit"></i> <u>Support</u></a></span>

<div>
<div>LLDP allows you to know exactly on which port is a server (and reciprocally).</div>
<div>LLDP is an industry standard protocol designed to supplant proprietary Link-Layer protocols.</div>
<div>The goal of LLDP is to provide an inter-vendor compatible mechanism to deliver Link-Layer notifications to adjacent network devices.</div>
</div>

