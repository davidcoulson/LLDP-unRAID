require_once '/usr/local/emhttp/plugins/ulldpd/include/ulldpd_config.php';
$ulldpd_snap = ulldpd_snapshot();
list($ulldpd_hist) = ulldpd_state_load();
$ulldpd_csrf = isset($var['csrf_token']) ? htmlspecialchars($var['csrf_token'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') : '';
$ulldpd_custom = '';
if (is_readable(ULLDPD_CUSTOM_FILE) && filesize(ULLDPD_CUSTOM_FILE) <= ULLDPD_CUSTOM_MAX) {
    $ulldpd_custom = (string)@file_get_contents(ULLDPD_CUSTOM_FILE);
}
function ulldpd_sel($cfg, $key, $label, $help) {
    $v = $cfg[$key];
    echo "<dl><dt>" . $label . ":</dt><dd><select id=\"$key\" name=\"$key\" size=\"1\">"
       . mk_option($v, 'disable', 'No') . mk_option($v, 'enable', 'Yes')
       . "</select></dd></dl>\n<blockquote class=\"inline_help\">" . $help . "</blockquote>\n";
}
function ulldpd_enum($cfg, $key, $label, $help, array $options) {
    $v = $cfg[$key];
    echo "<dl><dt>" . $label . ":</dt><dd><select id=\"$key\" name=\"$key\" size=\"1\">";
    foreach ($options as $val => $text) echo mk_option($v, $val, $text);
    echo "</select></dd></dl>\n<blockquote class=\"inline_help\">" . $help . "</blockquote>\n";
}
function ulldpd_txt($cfg, $key, $label, $help, $pattern, $max, $placeholder = '') {
    echo "<dl><dt>" . $label . ":</dt><dd><input type=\"text\" id=\"$key\" name=\"$key\" class=\"narrow\" style=\"width:30em\" maxlength=\"$max\" pattern=\""
       . ulldpd_h($pattern) . "\" placeholder=\"" . ulldpd_h($placeholder) . "\" value=\"" . ulldpd_h($cfg[$key]) . "\"></dd></dl>\n<blockquote class=\"inline_help\">" . $help . "</blockquote>\n";
}
?>

