    ulldpd_sel($ulldpd_cfg, 'FORCE', 'Force LLDP Protocol', '<p>Force to send LLDP packets even when there is no LLDP peer detected but there is a peer speaking another protocol detected.</p><p>By default (= <strong>\'No\'</strong>), LLDP packets are sent when there is a peer speaking LLDP detected or when there is no peer at all.</p>');
    ulldpd_sel($ulldpd_cfg, 'CDP', 'Enable CDP Protocol', '<p>CDP (Cisco Discovery Protocol): also send and understand Cisco\'s proprietary discovery frames, so Cisco routers and switches that do not speak LLDP can see this server and show up as neighbors.</p>');
    ulldpd_sel($ulldpd_cfg, 'FDP', 'Enable FDP Protocol', '<p>FDP (Foundry Discovery Protocol): the same for Foundry (now Brocade/Ruckus) network gear that does not speak LLDP.</p>');
    ulldpd_sel($ulldpd_cfg, 'SONMP', 'Enable SONMP Protocol', '<p>SONMP (SynOptics Network Management Protocol): the same for Nortel (now Avaya) routers and switches that do not speak LLDP.</p>');
    ulldpd_sel($ulldpd_cfg, 'EDP', 'Enable EDP Protocol', '<p>EDP (Extreme Discovery Protocol): the same for Extreme Networks routers and switches that do not speak LLDP.</p><p>Enable the legacy protocols only if your network equipment needs them; the neighbor table shows which protocol each neighbor used.</p>');
    ulldpd_sel($ulldpd_cfg, 'RXONLY', 'Receive-only Mode', '<p>When <strong>\'Yes\'</strong> this server listens for neighbors but never transmits LLDP frames (lldpd option <code>-r</code>).</p>');
    ulldpd_sel($ulldpd_cfg, 'IFALIAS', 'Update Interface Descriptions', '<p>When <strong>\'Yes\'</strong> lldpd sets each interface\'s description (ifAlias) to the name of the neighbor found on it, or to the number of neighbors.</p>');
    ulldpd_txt($ulldpd_cfg, 'IFACES', 'Interface Pattern', '<p>Comma separated list of interfaces to use; wildcards (<code>*</code>) are allowed, and a leading <code>!</code> excludes an interface, e.g. <code>eth*,!eth2</code>. Default: <code>eth*</code>. Allowed characters: letters, digits and <code>_ . * , ! -</code>.</p>', '[A-Za-z0-9_.*,!\-]{1,128}', 128, 'eth*');
    ulldpd_txt($ulldpd_cfg, 'MGMT_PATTERN', 'Management Address Pattern', '<p>Which of this server\'s addresses are advertised as management addresses (comma separated, wildcards and <code>!</code> exclusions allowed). Without it the first IPv4 and IPv6 address are used. Example to leave out the Tailscale IPv6 address: <code>!fd7a:115c:a1e0:*</code>; to remove all IPv6 addresses: <code>!*:*</code>. Only hexadecimal digits and <code>. : / * , !</code> are accepted. Leave empty for the default.</p>', '[0-9A-Fa-f.:\/*,!]{0,256}', 256, '!fd7a:115c:a1e0:*');
    ulldpd_txt($ulldpd_cfg, 'CHASSIS_IFACE', 'Interface for Chassis ID', '<p>Interface (or pattern) whose MAC address is used to compute the chassis ID advertised to neighbors. Leave empty for the default. Same allowed characters as the interface pattern.</p>', '[A-Za-z0-9_.*,!\-]{0,128}', 128, 'eth0');
    ulldpd_txt($ulldpd_cfg, 'SYSNAME', 'System Name Override', '<p>Name advertised to neighbors instead of the server\'s hostname. Letters, digits, <code>. _ -</code>, up to 63 characters. Leave empty to use the hostname.</p>', '[A-Za-z0-9._\-]{0,63}', 63, '');
