<script>
var ulldpdRunning = <?=json_encode($ulldpd_snap['running']);?>;
var ulldpdCsrf = <?=json_encode($var['csrf_token'] ?? '');?>;
function checkRUNNING(){
    // protocol controls stay enabled (disabled controls are not POSTed and would be
    // dropped from the configuration); Apply restarts a running service
    if ($('#SERVICE').val() === 'enable')
        $('#command').val('/usr/local/emhttp/plugins/ulldpd/scripts/' + (ulldpdRunning ? 'restart' : 'start'));
    else
        $('#command').val('/usr/local/emhttp/plugins/ulldpd/scripts/stop');
    $('#RESTART').prop('disabled', !ulldpdRunning);
}
function Restart() {
    $('#command').val('/usr/local/emhttp/plugins/ulldpd/scripts/restart');
}
// all HTML below is escaped server-side (include/status.php)
function ulldpdRefresh() {
    if (document.hidden) return;
    $.post('/plugins/ulldpd/include/status.php', {what: 'all', csrf_token: ulldpdCsrf}, function(d) {
        if (!d || d.error) return;
        ulldpdRunning = !!d.running;
        $('#ulldpd-status').html(d.status);
        $('#ulldpd-neighbors').html(d.neighbors);
        $('#ulldpd-chassis').html(d.chassis);
        checkRUNNING();
    }, 'json');
}
function ulldpdSaveCustom() {
    $('#ulldpd-custom-msg').text('Saving...');
    $.post('/plugins/ulldpd/include/save_custom.php', {content: $('#ulldpd-custom').val(), csrf_token: ulldpdCsrf}, 'json')
        .done(function(d) { $('#ulldpd-custom-msg').text(d && d.message ? d.message : 'Saved.'); })
        .fail(function(x) {
            var m = 'Save failed.';
            try { m = JSON.parse(x.responseText).error || m; } catch (e) {}
            $('#ulldpd-custom-msg').text(m);
        });
}
$(function() {
    $('#SERVICE').change(checkRUNNING);
    $('#RESTART').click(Restart);
    $('#ulldpd-refresh').click(ulldpdRefresh);
    $('#ulldpd-custom-save').click(ulldpdSaveCustom);

    checkRUNNING();
    setInterval(ulldpdRefresh, 10000);

    showStatus('lldpd');

    if ( typeof caPluginUpdateCheck === "function" ) {
        caPluginUpdateCheck("ulldpd.plg",{name:"LLDP"});
    }
});
</script>
